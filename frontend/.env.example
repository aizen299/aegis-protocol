NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_API_URL=http://127.0.0.1:8090
# Chains served, by registry name, the first being the default. Match the API's API_CHAINS.
NEXT_PUBLIC_CHAINS=anvil,solana-localnet
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_SOLANA_VAULT_MINT=
NEXT_PUBLIC_ASSET_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Comma-separated. "anvil" enables a keyless test wallet using Anvil's public development account, and
# only when the chain id is 31337. "solana-localnet" enables a browser-generated keypair, offered only on
# solana-localnet. Never set either for any other chain.
NEXT_PUBLIC_TEST_WALLET=
