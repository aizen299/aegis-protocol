.DS_Store

# Environment
.env
.env.local
*.env.local

# Build output.
# Anchored with a leading slash on purpose: an unanchored pattern like `cache/` matches a directory
# of that name at ANY depth, which silently swallowed the backend/internal/cache source package.
/contracts/out/
/contracts/cache/
/contracts/broadcast/
/contracts/deployments/
/zk/target/
/frontend/.next/
/frontend/out/
/frontend/tsconfig.tsbuildinfo
node_modules/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars

# Coverage
lcov.info
/contracts/coverage/
/frontend/coverage/
