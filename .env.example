# Local development. Copy to .env — .env is gitignored and must never hold real secrets.
# Staging and production read from AWS SSM Parameter Store, never from a file.

LOG_LEVEL=info

# Required, no default. Declares the environment rather than letting a process infer one from
# which variables happen to be set — see docs/v0.2-oracle-plan.md §2.7.
# One of: local | staging | production
APP_ENV=local

# AWS region for SSM. Required in staging and production, unused locally.
AWS_REGION=

# Names the environment variable holding the SLASHER_ROLE key locally, or the SSM parameter path
# in staging and production. The service refuses to start if the source fails — there is no
# fallback in either direction.
SLASHER_KEY_REF=SLASHER_PRIVATE_KEY

# Anvil's second default account. Test key, public knowledge, worthless off a local chain.
# In staging and production this variable is not read at all.
SLASHER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

CHAIN_RPC_URL=http://anvil:8545
CHAIN_ID=31337
CHAIN_CONFIRM_BLOCKS=1
CHAIN_START_BLOCK=0

# Set after `make deploy-local` prints the proxy address.
CONTRACT_VAULT_ENGINE=

# v0.2 oracle. Optional — leave blank to index only the vault. Staking and its stake token must be
# set together: a stake amount without the token that gives it a scale is uninterpretable.
CONTRACT_ORACLE_ROUNDS=
CONTRACT_ORACLE_STAKING=
CONTRACT_ORACLE_STAKE_TOKEN=

# `make aggregator` and `make oraclenode` start the two services that hold keys. Both sit behind a
# compose profile, so bringing up the stack does not start a signer unless asked.

# Oracle node. Sources and their JSON paths are positional and must be the same length. At least
# NODE_MIN_SOURCES of them must answer or the node stays silent rather than reporting a guess.
NODE_KEY_REF=NODE_PRIVATE_KEY
# Anvil's fourth default account. Public knowledge, worthless off a local chain.
NODE_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
NODE_FEED_NAME=ETH/USD
NODE_SOURCES=
NODE_SOURCE_PATHS=
NODE_MIN_SOURCES=3

# Deploy key. `make deploy-local` and `make deploy-oracle-local` default this to Anvil's first
# account and do not read it from here. Set it only for deploys against something other than Anvil.
PRIVATE_KEY=

# Foundry deploy script inputs.
VAULT_ADMIN=
VAULT_ASSET=
VAULT_DEPOSIT_CAP=0
VAULT_MIN_DEPOSIT=1000000000000000
VAULT_MAX_ALLOC_BPS=8000

ARBITRUM_SEPOLIA_RPC_URL=
ARBISCAN_API_KEY=
