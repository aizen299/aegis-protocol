# Local development. Copy to .env — .env is gitignored and must never hold real secrets.
# Staging and production read from AWS SSM Parameter Store, never from a file.

LOG_LEVEL=info

CHAIN_RPC_URL=http://anvil:8545
CHAIN_ID=31337
CHAIN_CONFIRM_BLOCKS=1
CHAIN_START_BLOCK=0

# Set after `make deploy-local` prints the proxy address.
CONTRACT_VAULT_ENGINE=

# Foundry deploy script inputs.
VAULT_ADMIN=
VAULT_ASSET=
VAULT_DEPOSIT_CAP=0
VAULT_MIN_DEPOSIT=1000000000000000
VAULT_MAX_ALLOC_BPS=8000

ARBITRUM_SEPOLIA_RPC_URL=
ARBISCAN_API_KEY=
